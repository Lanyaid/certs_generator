# Home-Local-CA — paramètres de l'autorité de certification
# Le script propose ces valeurs une par une.
# Répondre OK pour accepter, ou saisir une nouvelle valeur.

CA_NAME="Home-Local-CA"
COUNTRY="ES"
STATE="Galicia"
LOCALITY="Arteixo"
ORGANIZATION="ServArt Ltd"
ORGANIZATIONAL_UNIT="IT"
COMMON_NAME="home.local.fr"

CA_DAYS="730"
KEY_TYPE="RSA"
KEY_SIZE="4096"
DIGEST="sha256"

# Clé privée non chiffrée ; le script applique chmod 600.
ENCRYPT_KEY="no"